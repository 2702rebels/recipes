{
  "printWidth": 120,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "es5",
  "bracketSameLine": true,
  "singleAttributePerLine": true,
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "./app/global.css",
  "tailwindFunctions": ["cn"],
  "overrides": [
    {
      "files": ["*.md", "*.mdx"],
      "options": { "proseWrap": "preserve" }
    }
  ]
}
